# ──────────────────────────────────────────────
#  Telegram AI Chatbot - Environment Variables
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Your Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# AI backend — any OpenAI-compatible /chat/completions endpoint.
# Examples:
#   Ollama (local):   http://localhost:11434/v1
#   LM Studio (local):http://localhost:1234/v1
#   OpenAI cloud:     https://api.openai.com/v1
AI_API_BASE=http://localhost:11434/v1

# API key for the backend above (leave empty for local servers that don't need one)
AI_API_KEY=

# Model name understood by your backend (e.g. llama3, mistral, gpt-4o-mini)
AI_MODEL=llama3

# Request timeout in seconds
AI_TIMEOUT=60

# System prompt that defines the bot's personality/behavior
SYSTEM_PROMPT=You are a helpful, friendly, and knowledgeable AI assistant. You answer questions clearly and concisely.

# Max tokens for AI responses
MAX_TOKENS=1024

# Temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# Allowed user IDs (comma-separated, leave empty to allow all users)
# Example: 123456789,987654321
ALLOWED_USERS=

# Admin user IDs (comma-separated, can access /report analytics)
# Example: 123456789
ADMIN_USERS=

# ──────────────────────────────────────────────
#  Webhook (optional)
#  Leave WEBHOOK_URL empty to run in polling mode.
#  Set it to your public HTTPS base URL to run in webhook mode.
# ──────────────────────────────────────────────

# Public HTTPS base URL Telegram will send updates to (e.g. https://bot.example.com)
WEBHOOK_URL=

# Local interface/port the webhook server listens on
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443

# URL path Telegram posts to (defaults to the bot token if left empty)
WEBHOOK_PATH=

# Optional secret token Telegram echoes back for request verification
WEBHOOK_SECRET_TOKEN=

# Port for the health-check server (GET /health) — only used in webhook mode
HEALTH_PORT=8081
